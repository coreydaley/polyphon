{
  "name": "Polyphon",
  "productName": "Polyphon",
  "version": "0.13.1",
  "description": "One chat. Many voices.",
  "main": ".vite/build/main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "build:e2e": "node scripts/build-e2e.mjs",
    "screenshots": "npx tsx scripts/take-screenshots.ts",
    "postinstall": "node node_modules/electron/install.js && node scripts/build-sqlcipher.mjs --mode=electron && node scripts/build-sqlcipher.mjs --mode=node"
  },
  "keywords": [],
  "author": "Polyphon AI",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "happy-dom": "^21.0.1",
    "knip": "^6.41.0",
    "node-gyp": "^13.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "geist": "^1.7.2",
    "hast-util-sanitize": "^5.0.2",
    "lucide-react": "^1.57.0",
    "openai": "^7.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-sanitize": "^6.0.0",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true,
    "fs-xattr": true,
    "macos-alias": true,
    "fsevents": false
  }
}
